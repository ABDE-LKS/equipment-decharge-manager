<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EquipmentDechargeManager.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="EquipmentDechargeManager.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="20">
            
            <!-- Page Title -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Spacing="2">
                    <TextBlock Text="Tableau de bord" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Synthèse de l'état du parc et suivi des décharges actives" FontSize="12" Foreground="#6B7280"/>
                </StackPanel>
            </DockPanel>

            <!-- Error Message if any -->
            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" 
                    CornerRadius="4" Padding="12" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="12"/>
            </Border>

            <!-- Enterprise Statistics Summary Bar (5 Metrics) -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="16">
                <Grid ColumnDefinitions="*, Auto, *, Auto, *, Auto, *, Auto, *" VerticalAlignment="Center">
                    
                    <!-- Total Equipment -->
                    <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="TOTAL ÉQUIPEMENTS" FontSize="10" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalEquipmentCount}" FontSize="22" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Height="36" Background="#E5E7EB"/>

                    <!-- Disponibles -->
                    <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="DISPONIBLES" FontSize="10" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AvailableCount}" FontSize="22" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="3" Width="1" Height="36" Background="#E5E7EB"/>

                    <!-- Assignés -->
                    <StackPanel Grid.Column="4" Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="ASSIGNÉS" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AssignedCount}" FontSize="22" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="5" Width="1" Height="36" Background="#E5E7EB"/>

                    <!-- Employés -->
                    <StackPanel Grid.Column="6" Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="TOTAL EMPLOYÉS" FontSize="10" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalEmployeesCount}" FontSize="22" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="7" Width="1" Height="36" Background="#E5E7EB"/>

                    <!-- Décharges Actives -->
                    <StackPanel Grid.Column="8" Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="DÉCHARGES ACTIVES" FontSize="10" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalDechargesCount}" FontSize="22" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Enterprise Data Grid: Dernières décharges -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Dernières décharges actives" FontSize="14" FontWeight="Bold" Foreground="#111827"/>
                        <Button Grid.Column="1" Content="Voir Tout" 
                                Command="{Binding ToggleTableExpansionCommand}"
                                IsVisible="{Binding !IsTableExpanded}"
                                Classes="outline" Padding="10,4" FontSize="11"/>
                    </Grid>

                    <!-- Table Header -->
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12,8" CornerRadius="4">
                        <Grid ColumnDefinitions="1.5*, 2*, 1.2*, 1*, 1.2*">
                            <TextBlock Grid.Column="0" Text="N° DÉCHARGE" FontSize="10" FontWeight="Bold" Foreground="#4B5563"/>
                            <TextBlock Grid.Column="1" Text="EMPLOYÉ" FontSize="10" FontWeight="Bold" Foreground="#4B5563"/>
                            <TextBlock Grid.Column="2" Text="DATE" FontSize="10" FontWeight="Bold" Foreground="#4B5563"/>
                            <TextBlock Grid.Column="3" Text="ARTICLES" FontSize="10" FontWeight="Bold" Foreground="#4B5563"/>
                            <TextBlock Grid.Column="4" Text="STATUT" FontSize="10" FontWeight="Bold" Foreground="#4B5563"/>
                        </Grid>
                    </Border>

                    <!-- Table Rows -->
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecentDecharges}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="12,9">
                                        <Grid ColumnDefinitions="1.5*, 2*, 1.2*, 1*, 1.2*">
                                            <TextBlock Grid.Column="0" Text="{Binding DechargeNumber}" FontWeight="SemiBold" FontSize="12" Foreground="#2563EB" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding EmployeeName}" FontSize="12" Foreground="#111827" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding IssueDate, StringFormat=\{0:dd/MM/yyyy\}}" FontSize="12" Foreground="#4B5563" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding ItemCount}" FontSize="12" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
                                            
                                            <!-- Simple Text Badge Pill -->
                                            <Border Grid.Column="4" HorizontalAlignment="Left" Padding="8,2" CornerRadius="3" Background="#FEF3C7">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="#92400E"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

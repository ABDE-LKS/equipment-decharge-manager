<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EquipmentDechargeManager.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="EquipmentDechargeManager.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

    <Grid RowDefinitions="Auto, Auto, *">
        
        <!-- Top Header Bar -->
        <Border Grid.Row="0" Margin="20,16,20,12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Parc d'Équipements" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Inventaire du matériel informatique et suivi des statuts" FontSize="12" Foreground="#6B7280"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{Binding OpenAddFormCommand}" Classes="accent" Padding="14,6" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="＋" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="Ajouter un équipement" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LoadEquipmentCommand}" Classes="outline" Padding="12,6" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" FontSize="12"/>
                            <TextBlock Text="Actualiser" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Search & Filter Controls -->
        <StackPanel Grid.Row="1" Margin="20,0,20,12" Spacing="10">
            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="12,8"
                    IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding SuccessMessage}" FontSize="12" Foreground="#065F46" FontWeight="Medium"/>
            </Border>

            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12">
                <Grid ColumnDefinitions="*, 180, Auto" ColumnSpacing="10">
                    <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}" 
                             PlaceholderText="Rechercher par n° inventaire, type, marque, modèle, n° série..." 
                             Padding="10,6" CornerRadius="4"/>
                    
                    <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" 
                              HorizontalAlignment="Stretch" Padding="10,4" CornerRadius="4">
                    </ComboBox>

                    <Button Grid.Column="2" Command="{Binding LoadEquipmentCommand}" Classes="outline" Padding="12,6" CornerRadius="4">
                        <TextBlock Text="🔍 Filtrer" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Main Workspace Area (Data Grid + Side Form Panel) -->
        <Grid Grid.Row="2" Margin="20,0,20,16" ColumnDefinitions="*, Auto">
            
            <!-- Equipment Data Grid Container -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12">
                <Grid RowDefinitions="Auto, *">
                    
                    <!-- Table Header Grid -->
                    <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12,8" CornerRadius="4">
                        <Grid ColumnDefinitions="1.2*, 1.2*, 2*, 1.1*, 1.2*, 1*, Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="N° INVENTAIRE" FontSize="10" FontWeight="Bold" Foreground="#4B5563"/>
                            <TextBlock Grid.Column="1" Text="TYPE" FontSize="10" FontWeight="Bold" Foreground="#4B5563"/>
                            <TextBlock Grid.Column="2" Text="MARQUE / MODÈLE" FontSize="10" FontWeight="Bold" Foreground="#4B5563"/>
                            <TextBlock Grid.Column="3" Text="CODE SH" FontSize="10" FontWeight="Bold" Foreground="#4B5563"/>
                            <TextBlock Grid.Column="4" Text="N° SÉRIE" FontSize="10" FontWeight="Bold" Foreground="#4B5563"/>
                            <TextBlock Grid.Column="5" Text="STATUT" FontSize="10" FontWeight="Bold" Foreground="#4B5563"/>
                            <TextBlock Grid.Column="6" Text="ACTIONS" FontSize="10" FontWeight="Bold" Foreground="#4B5563" Width="76" TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Table Rows -->
                    <ScrollViewer Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Equipments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="12,8">
                                        <Grid ColumnDefinitions="1.2*, 1.2*, 2*, 1.1*, 1.2*, 1*, Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="{Binding InventoryNumber}" FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Type}" FontWeight="Bold" FontSize="12" Foreground="#111827" VerticalAlignment="Center"/>
                                            
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Brand}" FontWeight="SemiBold" FontSize="12" Foreground="#111827"/>
                                                <TextBlock Text="{Binding Model}" FontSize="11" Foreground="#6B7280"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="{Binding ShCode}" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding SerialNumber}" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                                            
                                            <!-- Status Badge using StatusText -->
                                            <Border Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,2" CornerRadius="3">
                                                <Border.Styles>
                                                    <Style Selector="Border">
                                                        <Setter Property="Background" Value="#DEF7EC"/>
                                                    </Style>
                                                    <Style Selector="Border[Tag=Assigné]">
                                                        <Setter Property="Background" Value="#E1EFFE"/>
                                                    </Style>
                                                </Border.Styles>
                                                <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Styles>
                                                        <Style Selector="TextBlock">
                                                            <Setter Property="Foreground" Value="#03543F"/>
                                                        </Style>
                                                    </TextBlock.Styles>
                                                </TextBlock>
                                            </Border>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" Width="76" HorizontalAlignment="Center">
                                                <Button Classes="icon-edit" 
                                                        Command="{Binding $parent[UserControl].((vm:EquipmentViewModel)DataContext).OpenEditFormCommand}" 
                                                        CommandParameter="{Binding}" ToolTip.Tip="Modifier">
                                                    <TextBlock Text="✏️" FontSize="11"/>
                                                </Button>
                                                <Button Classes="icon-delete" 
                                                        Command="{Binding $parent[UserControl].((vm:EquipmentViewModel)DataContext).OpenDeleteConfirmationCommand}" 
                                                        CommandParameter="{Binding}" ToolTip.Tip="Supprimer">
                                                    <TextBlock Text="🗑️" FontSize="11"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Inline Side Form (Add/Edit Equipment) -->
            <Border Grid.Column="1" Width="340" Margin="16,0,0,0" 
                    Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                    CornerRadius="4" Padding="16" 
                    IsVisible="{Binding IsFormOpen}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding FormTitle}" FontSize="15" FontWeight="Bold" Foreground="#111827"/>
                        <Border Height="1" Background="#E5E7EB" Margin="0,-4,0,0"/>

                        <!-- Error Banner -->
                        <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" 
                                CornerRadius="4" Padding="10" 
                                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Type d'équipement *" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBox Text="{Binding Type, Mode=TwoWay}" PlaceholderText="Laptop, Écran, Imprimante..." CornerRadius="4" Padding="10,6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Marque *" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBox Text="{Binding Brand, Mode=TwoWay}" PlaceholderText="HP, Dell, Lenovo..." CornerRadius="4" Padding="10,6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Modèle *" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBox Text="{Binding Model, Mode=TwoWay}" CornerRadius="4" Padding="10,6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Code SH" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBox Text="{Binding ShCode, Mode=TwoWay}" CornerRadius="4" Padding="10,6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="N° de Série" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBox Text="{Binding SerialNumber, Mode=TwoWay}" CornerRadius="4" Padding="10,6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="N° d'Inventaire" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                            <TextBox Text="{Binding InventoryNumber, Mode=TwoWay}" CornerRadius="4" Padding="10,6"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Statut initial *" FontSize="12" FontWeight="SemiBold" Foreground="#374151"/>
                            <ComboBox SelectedItem="{Binding Status, Mode=TwoWay}" ItemsSource="{Binding EquipmentStatusOptions}" HorizontalAlignment="Stretch" CornerRadius="4"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
                            <Button Content="Annuler" Command="{Binding CancelFormCommand}" Classes="outline" Padding="12,6" CornerRadius="4"/>
                            <Button Content="Enregistrer" Command="{Binding SaveFormCommand}" Classes="accent" Padding="14,6" CornerRadius="4"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>

        <!-- Delete Confirmation Dialog Overlay -->
        <Border IsVisible="{Binding IsDeleteConfirmOpen}" Background="#60000000" ZIndex="100" Grid.RowSpan="3">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Background="White" CornerRadius="4" Padding="20">
                <Grid RowDefinitions="Auto, *, Auto">
                    <Border Grid.Row="0" Padding="0,0,0,12" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Supprimer l'équipement" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="Confirmation de la suppression" FontSize="12" Foreground="#6B7280"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,14">
                        <StackPanel Spacing="12">
                            <!-- Equipment Details Card -->
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding EquipmentToDelete.Brand, StringFormat='Marque : {0}'}" FontSize="13" FontWeight="Bold" Foreground="#111827"/>
                                    <TextBlock Text="{Binding EquipmentToDelete.Type, StringFormat='Type : {0}'}" FontSize="12" Foreground="#374151"/>
                                    <TextBlock Text="{Binding EquipmentToDelete.InventoryNumber, StringFormat='N° Inventaire : {0}'}" FontSize="12" Foreground="#6B7280"/>
                                </StackPanel>
                            </Border>

                            <!-- Warning banner when deletion is BLOCKED -->
                            <Border IsVisible="{Binding !CanDeleteEquipment}" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Padding="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="⚠️ Impossible de supprimer cet équipement" FontSize="12" FontWeight="Bold" Foreground="#991B1B"/>
                                    <TextBlock Text="Impossible de supprimer cet équipement car il est actuellement affecté à une décharge active."
                                               FontSize="12" Foreground="#991B1B" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Confirmation prompt when deletion is ALLOWED -->
                            <Border IsVisible="{Binding CanDeleteEquipment}" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Êtes-vous sûr de vouloir supprimer cet équipement ?" FontSize="12" FontWeight="Bold" Foreground="#B45309"/>
                                    <TextBlock Text="Cette action supprimera définitivement cet équipement du parc." FontSize="12" Foreground="#78350F" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="10"
                                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="0,12,0,0" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="Fermer" Command="{Binding CancelDeleteConfirmationCommand}" Classes="outline" IsVisible="{Binding !CanDeleteEquipment}" Padding="12,6" CornerRadius="4"/>
                            <Button Content="Annuler" Command="{Binding CancelDeleteConfirmationCommand}" Classes="outline" IsVisible="{Binding CanDeleteEquipment}" Padding="12,6" CornerRadius="4"/>
                            <Button Content="Confirmer la suppression" Command="{Binding ConfirmDeleteEquipmentCommand}" Classes="danger" IsVisible="{Binding CanDeleteEquipment}" Padding="14,6" CornerRadius="4"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

    </Grid>
</UserControl>

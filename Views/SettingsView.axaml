<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EquipmentDechargeManager.ViewModels"
             xmlns:views="clr-namespace:EquipmentDechargeManager.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="EquipmentDechargeManager.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Settings Header & Navigation Tab Bar -->
        <Border Grid.Row="0" Margin="20,16,20,12" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Paramètres &amp; Importation de Données" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Importation en masse des listes d'employés et d'équipements depuis des fichiers Excel / CSV" FontSize="12" Foreground="#6B7280"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="👥 Importer Employés" 
                            Command="{Binding SelectEmployeesImportCommand}" 
                            Classes="outline" Padding="12,6" CornerRadius="4"/>
                    <Button Content="💻 Importer Équipements" 
                            Command="{Binding SelectEquipmentImportCommand}" 
                            Classes="outline" Padding="12,6" CornerRadius="4"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Active Data Import Wizard Host -->
        <TransitioningContentControl Grid.Row="1" Content="{Binding ActiveWizard}"/>

    </Grid>
</UserControl>

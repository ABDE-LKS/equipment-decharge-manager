<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EquipmentDechargeManager.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="EquipmentDechargeManager.Views.DataImportWizardView"
             x:DataType="vm:DataImportWizardViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,16">
        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Title -->
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#111827"/>

            <!-- Error Banner -->
            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" 
                    CornerRadius="4" Padding="12,8" 
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- Loading Indicator -->
            <Border Background="#EFF6FF" BorderBrush="#2563EB" BorderThickness="1" 
                    CornerRadius="4" Padding="12,8" IsVisible="{Binding IsLoading}">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="⏳ Traitement du fichier en cours..." FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                </StackPanel>
            </Border>

            <!-- ================= STEP 1: FILE SELECTION ================= -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="32"
                    IsVisible="{Binding IsStep1}">
                <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Sélectionner un fichier Excel ou CSV" FontSize="16" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                    <TextBlock Text="Formats acceptés : .xlsx, .csv" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center"/>

                    <Button Command="{Binding BrowseFileCommand}" Classes="accent" Padding="16,8" CornerRadius="4" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📁 Parcourir le fichier" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding FileName, StringFormat='Fichier sélectionné : {0}'}" 
                               FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Center"
                               IsVisible="{Binding FileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>

            <!-- ================= STEP 2 & 3: PREVIEW & MAPPING ================= -->
            <Grid ColumnDefinitions="360, *" 
                  IsVisible="{Binding IsStep2}">
                
                <!-- Left Column: Column Mapping -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,14,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Correspondance des colonnes" FontSize="14" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Associez chaque champ aux colonnes de votre fichier :" FontSize="11" Foreground="#6B7280"/>

                        <ItemsControl ItemsSource="{Binding ColumnMappings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="3" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding DbFieldLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#374151"/>
                                            <TextBlock Text="*" Foreground="#DC2626" IsVisible="{Binding IsRequired}"/>
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding AvailableSourceHeaders}" 
                                                  SelectedItem="{Binding SelectedSourceHeader, Mode=TwoWay}" 
                                                  HorizontalAlignment="Stretch" CornerRadius="4" Padding="8,5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Content="Changer de fichier" Command="{Binding ResetWizardCommand}" Classes="outline" Padding="12,6" CornerRadius="4"/>
                            <Button Content="Valider &amp; Analyser" Command="{Binding ValidateMappingAndProceedCommand}" Classes="accent" Padding="14,6" CornerRadius="4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right Column: Data Preview -->
                <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Aperçu du fichier (Premières lignes)" FontSize="14" FontWeight="Bold" Foreground="#111827"/>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="450">
                            <ItemsControl ItemsSource="{Binding PreviewRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="8,6">
                                            <ItemsControl ItemsSource="{Binding}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="14"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Width="120" FontSize="11" Foreground="#374151"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= STEP 4: VALIDATION SUMMARY ================= -->
            <StackPanel Spacing="14" IsVisible="{Binding IsStep4}">
                
                <!-- Metrics Summary Bar -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="10">
                    <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="TOTAL LIGNES" FontSize="10" FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Text="{Binding ValidationResult.TotalRows}" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="4" Padding="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="VALIDES" FontSize="10" FontWeight="Bold" Foreground="#047857"/>
                            <TextBlock Text="{Binding ValidationResult.ValidCount}" FontSize="20" FontWeight="Bold" Foreground="#059669"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="DOUBLONS IGNORÉS" FontSize="10" FontWeight="Bold" Foreground="#B45309"/>
                            <TextBlock Text="{Binding ValidationResult.DuplicateCount}" FontSize="20" FontWeight="Bold" Foreground="#D97706"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Padding="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="EN ERREUR" FontSize="10" FontWeight="Bold" Foreground="#991B1B"/>
                            <TextBlock Text="{Binding ValidationResult.ErrorCount}" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Detailed Error Grid -->
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Détail des erreurs / doublons" FontSize="14" FontWeight="Bold" Foreground="#111827"/>

                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10,6" CornerRadius="4">
                            <Grid ColumnDefinitions="80, 180, *">
                                <TextBlock Grid.Column="0" Text="LIGNE" FontSize="10" FontWeight="Bold" Foreground="#4B5563"/>
                                <TextBlock Grid.Column="1" Text="VALEUR" FontSize="10" FontWeight="Bold" Foreground="#4B5563"/>
                                <TextBlock Grid.Column="2" Text="RAISON" FontSize="10" FontWeight="Bold" Foreground="#4B5563"/>
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250">
                            <ItemsControl ItemsSource="{Binding ValidationErrors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="10,6">
                                            <Grid ColumnDefinitions="80, 180, *">
                                                <TextBlock Grid.Column="0" Text="{Binding RowNumber, StringFormat='Ligne {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#111827"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Key}" FontSize="11" Foreground="#374151"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Reason}" FontSize="11" Foreground="#DC2626"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Action Bar -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                            <Button Content="Retour au mappage" Command="{Binding GoBackToStepCommand}" CommandParameter="2" Classes="outline" Padding="12,6" CornerRadius="4"/>
                            <Button Content="Lancer l'importation" Command="{Binding ExecuteImportCommand}" Classes="accent" Padding="14,6" CornerRadius="4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= STEP 4: RESULT CONFIRMATION ================= -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="32"
                    IsVisible="{Binding IsStep4}">
                <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Importation terminée avec succès !" FontSize="18" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center"/>

                    <Grid ColumnDefinitions="*, *" Width="300" HorizontalAlignment="Center">
                        <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Text="Lignes importées" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ImportedCount}" FontSize="22" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Text="Lignes ignorées" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SkippedCount}" FontSize="22" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="Importer un autre fichier" Command="{Binding ResetWizardCommand}" Classes="accent" HorizontalAlignment="Center" Padding="16,8" CornerRadius="4"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

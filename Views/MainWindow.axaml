<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentDechargeManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="EquipmentDechargeManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Equipment Decharge Manager"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="False">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *">
        
        <!-- Custom Top Title Bar (Visible Title & Window Controls) -->
        <Border Grid.Row="0" Background="#0F172A" Height="36" Padding="12,0,0,0" PointerPressed="Header_PointerPressed">
            <Grid ColumnDefinitions="Auto, *, Auto">
                
                <!-- App Icon & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="avares://EquipmentDechargeManager/Assets/sonatrach_logo_wt.png" 
                           Height="18" Width="18" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="Equipment Decharge Manager" 
                               Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Draggable Center Space -->
                <Panel Grid.Column="1" Background="Transparent"/>

                <!-- Window Action Buttons (Minimize, Maximize, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Stretch">
                    <Button Click="MinimizeWindow_Click" Width="46" Height="36" Background="Transparent" 
                            Foreground="#9CA3AF" CornerRadius="0" Padding="0" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                            ToolTip.Tip="Réduire">
                        <TextBlock Text="—" FontSize="11" FontWeight="Bold"/>
                    </Button>

                    <Button Click="MaximizeWindow_Click" Width="46" Height="36" Background="Transparent" 
                            Foreground="#9CA3AF" CornerRadius="0" Padding="0" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                            ToolTip.Tip="Agrandir / Restaurer">
                        <TextBlock Text="▢" FontSize="12" FontWeight="Bold"/>
                    </Button>

                    <Button Click="CloseWindow_Click" Width="46" Height="36" Background="Transparent" 
                            Foreground="#9CA3AF" CornerRadius="0" Padding="0" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                            ToolTip.Tip="Fermer">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </Button.Styles>
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Main Body (Sidebar + Right Content Workspace) -->
        <Grid Grid.Row="1" ColumnDefinitions="210, *">
            
            <!-- Sidebar Navigation (Dark Navy #1E293B) -->
            <Border Grid.Column="0" Background="#1E293B" Padding="12,16">
                <Grid RowDefinitions="Auto, *, Auto">
                    
                    <!-- Sidebar Header / Sonatrach Branding -->
                    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Source="avares://EquipmentDechargeManager/Assets/sonatrach_logo_wt.png" 
                                   Height="28" Width="28" Stretch="Uniform" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="SONATRACH" FontSize="13" FontWeight="Bold" Foreground="White" LetterSpacing="0.5"/>
                                <TextBlock Text="Gestion des Décharges" FontSize="10" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="#374151" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Nav Menu Items -->
                    <StackPanel Grid.Row="1" Spacing="4">
                        <!-- Dashboard -->
                        <Button Classes="nav-btn"
                                Classes.active="{Binding IsDashboardActive}"
                                Command="{Binding NavigateDashboardCommand}" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Left"
                                Padding="10,8" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="📊" FontSize="13"/>
                                <TextBlock Text="Tableau de bord" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Employees -->
                        <Button Classes="nav-btn"
                                Classes.active="{Binding IsEmployeesActive}"
                                Command="{Binding NavigateEmployeesCommand}" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Left"
                                Padding="10,8" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="👤" FontSize="13"/>
                                <TextBlock Text="Employés" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Equipment -->
                        <Button Classes="nav-btn"
                                Classes.active="{Binding IsEquipmentActive}"
                                Command="{Binding NavigateEquipmentCommand}" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Left"
                                Padding="10,8" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="💻" FontSize="13"/>
                                <TextBlock Text="Équipements" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Decharges -->
                        <Button Classes="nav-btn"
                                Classes.active="{Binding IsDechargesActive}"
                                Command="{Binding NavigateDechargesCommand}" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Left"
                                Padding="10,8" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="📋" FontSize="13"/>
                                <TextBlock Text="Décharges" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- History -->
                        <Button Classes="nav-btn"
                                Classes.active="{Binding IsHistoryActive}"
                                Command="{Binding NavigateHistoryCommand}" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Left"
                                Padding="10,8" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🕒" FontSize="13"/>
                                <TextBlock Text="Historique" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Settings / Paramètres -->
                        <Button Classes="nav-btn"
                                Classes.active="{Binding IsSettingsActive}"
                                Command="{Binding NavigateSettingsCommand}" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Left"
                                Padding="10,8" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⚙️" FontSize="13"/>
                                <TextBlock Text="Paramètres" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Sidebar Footer Status (Discreet) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="4,4,4,0">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" VerticalAlignment="Center"/>
                        <TextBlock Text="Base de données connectée" FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Right Content Area (Main View Host) -->
            <Border Grid.Column="1" Background="#F3F4F6">
                <TransitioningContentControl Content="{Binding CurrentView}"/>
            </Border>

        </Grid>
    </Grid>
</Window>
